# Copia este archivo como .env.local y completa la clave en tu ordenador.
# Nunca subas .env.local a GitHub.
GEMINI_API_KEY=pega_tu_clave_localmente
GEMINI_MODEL=gemini-3.5-flash-lite
AI_SERVER_PORT=3002
# Solo para una compilación de producción con el endpoint PHP del hosting:
# REACT_APP_AI_API_PATH=/chacalon/api/ai/chat.php
# En producción, leer el contexto diario actualizado desde GitHub:
# REACT_APP_CONTEXT_URL=https://raw.githubusercontent.com/estolar/retro-games-streaming/main/public/data/context.json
